{
  "name": "pulso",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "concurrently -n web,signal -c cyan,magenta \"vite --host 0.0.0.0\" \"node --watch server/index.mjs --port=8787\"",
    "build": "tsc -b && vite build",
    "test": "vitest run src && node --test server/*.test.mjs cloudflare/*.test.mjs && node scripts/smoke-realtime.mjs",
    "test:unit": "vitest run src",
    "test:realtime": "node scripts/smoke-realtime.mjs",
    "test:server": "node --test server/*.test.mjs",
    "cloudflare:dev": "npm run build && wrangler dev",
    "cloudflare:test": "node --test cloudflare/*.test.mjs",
    "cloudflare:typecheck": "tsc -p tsconfig.cloudflare.json",
    "cloudflare:check": "npm run build && npm run cloudflare:typecheck && wrangler deploy --dry-run",
    "cloudflare:smoke": "npm run build && node cloudflare/smoke.mjs",
    "cloudflare:deploy": "npm run build && wrangler deploy",
    "desktop:install": "npm --prefix desktop install",
    "desktop:start": "npm --prefix desktop start",
    "desktop:smoke": "npm --prefix desktop run smoke",
    "desktop:make": "npm --prefix desktop run make",
    "preview": "vite preview --host 0.0.0.0",
    "start": "node server/index.mjs"
  },
  "dependencies": {
    "@fontsource/bricolage-grotesque": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "express": "^5.2.1",
    "lucide-react": "^1.33.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/ws": "^8.18.1",
    "@cloudflare/workers-types": "5.20260821.1",
    "@vitejs/plugin-react": "^6.0.5",
    "concurrently": "^10.0.5",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.11",
    "wrangler": "4.125.0"
  }
}
