# Um STUN é suficiente para desenvolvimento e parte das redes domésticas.
VITE_STUN_URL=stun:stun.l.google.com:19302

# Em produção, prefira credenciais TURN temporárias. Quando definido, este JSON
# substitui VITE_STUN_URL.
# VITE_ICE_SERVERS=[{"urls":"stun:seu-dominio.com:3478"},{"urls":"turn:seu-dominio.com:3478","username":"temporario","credential":"temporario"}]

# Servidor Node. Em produção, mantenha a aplicação atrás do Caddy e defina a
# origem HTTPS exata. Mais de uma origem pode ser separada por vírgulas.
# HOST=127.0.0.1
# PORT=4173
# ALLOWED_ORIGINS=https://pulso.seudominio.com
# MAX_CLIENTS=100
