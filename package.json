{
  "name": "pulso",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "concurrently -n web,signal -c cyan,magenta \"vite --host 0.0.0.0\" \"node --watch server/index.mjs --port=8787\"",
    "build": "tsc -b && vite build",
    "test": "vitest run && node scripts/smoke-realtime.mjs",
    "test:unit": "vitest run",
    "test:realtime": "node scripts/smoke-realtime.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "start": "node server/index.mjs"
  },
  "dependencies": {
    "@fontsource/bricolage-grotesque": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "express": "^5.2.1",
    "lucide-react": "^1.33.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.5",
    "concurrently": "^10.0.5",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.11"
  }
}
