{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pulso",
  "main": "cloudflare/worker/index.ts",
  "compatibility_date": "2026-08-21",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "WORKSPACES",
        "class_name": "Workspace"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "Workspace"
      ]
    }
  ],
  "vars": {
    "SITE_OFFLINE": "true",
    "DEFAULT_WORKSPACE_ID": "pulso-publico",
    "MAX_CLIENTS_PER_WORKSPACE": "100",
    "CLOUDFLARE_TURN_TTL": "900",
    "TURN_MIN_GRANT_INTERVAL_SECONDS": "600",
    "TURN_MAX_GRANTS_PER_SESSION_DAY": "12",
    "TURN_MAX_GRANTS_PER_IP_DAY": "24",
    "TURN_MAX_GRANTS_PER_ROOM_DAY": "96",
    "TURN_MAX_GRANTS_PER_WORKSPACE_DAY": "192"
  },
  "observability": {
    "enabled": true
  }
}
