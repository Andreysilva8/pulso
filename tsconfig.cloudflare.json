{
  "compilerOptions": {
    "target": "ES2024",
    "lib": [
      "ES2024",
      "WebWorker"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": [
      "@cloudflare/workers-types"
    ],
    "allowJs": true,
    "checkJs": false,
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noEmit": true
  },
  "include": [
    "cloudflare/worker/**/*.ts"
  ]
}
