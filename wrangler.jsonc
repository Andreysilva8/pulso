{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pulso",
  "main": "cloudflare/worker/index.ts",
  "compatibility_date": "2026-08-21",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/ws*"
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "WORKSPACES",
        "class_name": "Workspace"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "Workspace"
      ]
    }
  ],
  "vars": {
    "DEFAULT_WORKSPACE_ID": "pulso",
    "MAX_CLIENTS_PER_WORKSPACE": "100",
    "CLOUDFLARE_TURN_TTL": "3600"
  },
  "observability": {
    "enabled": true
  }
}
